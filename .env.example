MONGODB_URI=mongodb://127.0.0.1:27017/wildbasket
PORT=4001
# Only needed if you run "npm run dev" and the API on a non-default port/host.
# VITE_BACKEND_URL=http://localhost:4001

# Get a free API key at https://resend.com (100 emails/day free tier)
RESEND_API_KEY=
# Sender address. Without a verified domain on Resend, keep the sandbox address below.
RESEND_FROM=ОдеждаPRO <onboarding@resend.dev>

# Comma-separated list of browser origins allowed to call this API cross-site
# (see server/app.js). Only needed if the site is ever served from a domain
# other than the defaults baked into app.js.
# ALLOWED_ORIGINS=https://odejda-pro.ru,https://www.odejda-pro.ru
